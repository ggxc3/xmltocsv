{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "XmlToCsv",
  "version": "../package.json",
  "identifier": "sk.ggxc3.xmltocsv",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "XML → CSV",
        "width": 760,
        "height": 600,
        "minWidth": 560,
        "minHeight": 440
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
